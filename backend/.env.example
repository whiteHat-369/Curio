# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/curio"

# JWT (shared with Track A)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ISSUER="curio-api"

# Object Storage (S3-compatible)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="curio-files"
S3_PUBLIC_URL="http://localhost:9000/curio-files"

# Encryption key for API keys at rest (AES-256-GCM, 32 bytes hex-encoded)
API_KEY_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Shared secret for Track A -> Track B internal HTTP calls
INTERNAL_SERVICE_TOKEN="replace-with-a-long-random-service-token"

# AI Provider API Keys
GEMINI_API_KEY="AIza..."
OPENAI_API_KEY="sk-..."
GROK_API_KEY="xai-..."

# Server
PORT=3001
HOST="0.0.0.0"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000,http://localhost:8080"