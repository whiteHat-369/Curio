    "fastify": "^5.1.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.0",
    "uuid": "^11.0.0",
    "openai": "^4.70.0",
    "@google/generative-ai": "^0.21.0",
    "csv-parse": "^5.6.0",
    "xlsx": "^0.18.5",
    "parquetjs": "^0.11.2",
    "dotenv": "^16.4.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
